# Variables del entorno Docker (desarrollo). `make up` copia este archivo a .env
# la primera vez. Cambiá los puertos si ya tenés algo corriendo en ellos.

# Base de datos
DB_DATABASE=sistema_profesionales
DB_USERNAME=turnos
DB_PASSWORD=turnos_dev
DB_ROOT_PASSWORD=root_dev

# Puertos en tu máquina
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=4200
MOCK_API_PORT=3000
PMA_PORT=8081
MAILPIT_PORT=8025

# Administrador inicial de la plataforma (/gestion). Lo crea el seeder la primera vez.
# Contraseña vacía = se genera una aleatoria y se muestra en la consola al crear la base.
PLATAFORMA_ADMIN_NOMBRE=Administrador
PLATAFORMA_ADMIN_EMAIL=admin@turnos.local
PLATAFORMA_ADMIN_DNI=
PLATAFORMA_ADMIN_PASSWORD=
